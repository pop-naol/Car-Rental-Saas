### Health Check
GET http://localhost:5000/health

### Root Endpoint
GET http://localhost:5000/

###
### AUTHENTICATION
###

### Register Super Admin
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "email": "admin@carrental.com",
  "password": "Admin123!@#",
  "firstName": "Super",
  "lastName": "Admin",
  "role": "SUPER_ADMIN"
}

### Login Super Admin
# @name loginAdmin
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "admin@carrental.com",
  "password": "Admin123!@#"
}

###
### COMPANY MANAGEMENT (Super Admin Only)
###

@token = {{loginAdmin.response.body.accessToken}}

### Create Company
# @name createCompany
POST http://localhost:5000/api/companies
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Premium Car Rentals Inc",
  "subscriptionTier": "premium"
}

@companyId = {{createCompany.response.body.company.id}}

### Get All Companies
GET http://localhost:5000/api/companies
Authorization: Bearer {{token}}

### Get Company by ID
GET http://localhost:5000/api/companies/{{companyId}}
Authorization: Bearer {{token}}

### Update Company
PATCH http://localhost:5000/api/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Premium Car Rentals International",
  "subscriptionTier": "enterprise"
}

### Suspend Company
PATCH http://localhost:5000/api/companies/{{companyId}}/suspend
Authorization: Bearer {{token}}

### Activate Company
PATCH http://localhost:5000/api/companies/{{companyId}}/activate
Authorization: Bearer {{token}}

###
### BRANCH MANAGEMENT
###

### Register Company Manager
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "email": "manager@premium.com",
  "password": "Manager123!@#",
  "firstName": "John",
  "lastName": "Manager",
  "role": "COMPANY_MANAGER",
  "companyId": "{{companyId}}"
}

### Login Company Manager
# @name loginManager
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "manager@premium.com",
  "password": "Manager123!@#"
}

@managerToken = {{loginManager.response.body.accessToken}}

### Create Branch
# @name createBranch
POST http://localhost:5000/api/branches
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "companyId": "{{companyId}}",
  "name": "Downtown Branch",
  "address": "123 Main St, City, State 12345",
  "phone": "+1-555-0100",
  "email": "downtown@premium.com"
}

@branchId = {{createBranch.response.body.branch.id}}

### Get All Branches
GET http://localhost:5000/api/branches
Authorization: Bearer {{managerToken}}

### Get Branch by ID
GET http://localhost:5000/api/branches/{{branchId}}
Authorization: Bearer {{managerToken}}

### Update Branch
PATCH http://localhost:5000/api/branches/{{branchId}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "name": "Downtown Main Branch",
  "phone": "+1-555-0101"
}

### Delete Branch (will fail if has active rentals)
DELETE http://localhost:5000/api/branches/{{branchId}}
Authorization: Bearer {{managerToken}}

###
### ERROR CASES
###

### Login with Invalid Credentials
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "admin@carrental.com",
  "password": "wrongpassword"
}

### Access Company Endpoint Without Auth
GET http://localhost:5000/api/companies

### Employee Trying to Access Companies (should fail)
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "email": "employee@premium.com",
  "password": "Employee123!@#",
  "firstName": "Jane",
  "lastName": "Employee",
  "role": "EMPLOYEE",
  "companyId": "{{companyId}}"
}

### Login Employee
# @name loginEmployee
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "employee@premium.com",
  "password": "Employee123!@#"
}

@employeeToken = {{loginEmployee.response.body.accessToken}}

### Employee Trying to Create Company (should fail - forbidden)
POST http://localhost:5000/api/companies
Content-Type: application/json
Authorization: Bearer {{employeeToken}}

{
  "name": "Unauthorized Company"
}

